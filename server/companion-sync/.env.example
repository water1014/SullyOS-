# Copy this file to .env on the server. Never commit the filled-in .env.
# Point this DNS name to the server before starting Caddy.
COMPANION_DOMAIN=sync.example.com
ACME_EMAIL=admin@example.com

POSTGRES_DB=companion_sync
POSTGRES_USER=companion_sync
# Use a hex value so it is safe inside the PostgreSQL URL in compose.yaml.
POSTGRES_PASSWORD=replace-with-64-hex-characters

# Generate each secret independently with: openssl rand -hex 32
COMPANION_BOOTSTRAP_TOKEN=replace-with-64-hex-characters
COMPANION_TOKEN_PEPPER=replace-with-a-different-64-hex-characters

# Exact browser origins only. Do not use *.
COMPANION_CORS_ORIGINS=https://water1014.github.io
