# Copy this file to .env on the server. Never commit the filled-in .env.
# Point this DNS name to the server before starting Caddy.
COMPANION_DOMAIN=sync.example.com
ACME_EMAIL=admin@example.com

POSTGRES_DB=companion_sync
POSTGRES_USER=companion_sync
POSTGRES_PASSWORD=replace-with-a-long-random-database-password

# Generate each secret independently with: openssl rand -base64 48
COMPANION_BOOTSTRAP_TOKEN=replace-with-a-random-secret-at-least-32-characters
COMPANION_TOKEN_PEPPER=replace-with-a-different-random-secret-at-least-32-characters

# Exact browser origins only. Do not use *.
COMPANION_CORS_ORIGINS=https://water1014.github.io
